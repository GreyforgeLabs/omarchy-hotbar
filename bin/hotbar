#!/usr/bin/env bash
# hotbar — command-line companion for the Hotbar Omarchy bar widget.
#
# Everything here is a thin wrapper over the widget's `hotbar` IPC target or
# over `omarchy bar set`. No command is ever built from user input; arguments
# are passed through as discrete argv entries.
set -euo pipefail

PLUGIN_ID="greyforge.hotbar"

usage() {
  cat <<'EOF'
Usage: hotbar <command> [args]

Pins
  pin <app>              Pin an app. <app> is a desktop id (chromium), an
                         identity key (class:tui.float), or the app id / class
                         of something that is running right now.
  unpin <app>            Remove a pin.
  pins                   List pins in order, one per line.
  pins set <app>...      Replace the pin list (order = argument order).
  pins clear             Remove every pin.

Windows
  open places|running|settings
                     Open a popover.
  open <app>             Open an app's menu.
                         Add --screen <name> to target another monitor's bar.
  close [--screen <name>]
                         Close any open Hotbar popover.
  activate <app>         Launch / focus / cycle like a left click.
  activate <n>           Same for pinned slot n (1-based) — bind it to Super+n.
  new <app>              Open a new window like a middle click.
  identify               Show how every window was identified (for `matches`).

Setup
  install                Enable the widget, place it after the Omarchy menu,
                         and link this CLI into ~/.local/bin (never
                         overwrites a file owned by anything else).
  uninstall              Remove the owned CLI link, the HOTBAR state mirror,
                         and the plugin. Safe to run repeatedly.
  import omapanel [--apply]
                         Read OmaPanel's pinned apps from shell.json and turn
                         them into Hotbar pins. Prints the plan; --apply writes.
  set <key> <value>      Change a setting (JSON or plain string; see README).
  get <key>              Print a setting as JSON.
  state                  Dump the live model as JSON.
  doctor                 Check the installation.

Cursor warps (Hyprland yanks the pointer to window/workspace center
on focus — annoying for a mouse-driven bar; Omarchy enables
warp_on_change_workspace by default)
  warp status            Show cursor:no_warps, warp_on_change_workspace,
                         warp_on_toggle_special. Exit 0 disabled, 1 enabled.
  warp off               Disable cursor warps (managed block in
                         ~/.config/hypr/looknfeel.lua + hyprctl reload).
  warp on                Restore Omarchy default warps (same mechanism).
EOF
}

ipc() { omarchy-shell hotbar "$@"; }

# Preflight before every HOTBAR IPC command: confirm omarchy-shell itself is
# running, then poll `hotbar ping` for a short bounded period (the widget
# re-registers its IPC target ~400 ms after a plugin hot-reload). The
# requested operation is then performed exactly once — state-changing calls
# are never blindly retried.
hotbar_preflight() {
  if ! omarchy-shell shell ping >/dev/null 2>&1; then
    echo "hotbar: omarchy-shell is not running" >&2
    return 1
  fi
  local attempts="${HOTBAR_PREFLIGHT_ATTEMPTS:-8}"
  local interval="${HOTBAR_PREFLIGHT_INTERVAL:-0.1}"
  local i
  for ((i = 1; i <= attempts; i++)); do
    if omarchy-shell hotbar ping >/dev/null 2>&1; then return 0; fi
    sleep "$interval"
  done
  echo "hotbar: HOTBAR widget is not answering (it may be reloading — try again in a moment)" >&2
  return 1
}

need_shell() { hotbar_preflight; }

# Canonical path of this HOTBAR CLI, for ownership comparisons.
hotbar_cli_source() {
  realpath "${BASH_SOURCE[0]}" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}"
}

hotbar_cli_link() { printf '%s' "$HOME/.local/bin/hotbar"; }

hotbar_state_file() {
  printf '%s' "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/hotbar-settings.json"
}

# Resolve a symlink to a canonical path for comparison. Prints "" when the
# link is dangling and cannot be resolved.
resolve_link() {
  local p="$1" r=""
  r="$(realpath "$p" 2>/dev/null || true)"
  if [[ -n "$r" ]]; then printf '%s' "$r"; return 0; fi
  r="$(readlink "$p" 2>/dev/null || true)"
  printf '%s' "$r"
}

# True when ~/.local/bin/hotbar is a symlink resolving to this HOTBAR CLI.
cli_owned_by_hotbar() {
  local target src resolved
  target="$(hotbar_cli_link)"
  src="$(hotbar_cli_source)"
  [[ -L "$target" ]] || return 1
  resolved="$(resolve_link "$target")"
  [[ "$resolved" == "$src" ]]
}

install_cli_link() {
  local target src resolved
  target="$(hotbar_cli_link)"
  src="$(hotbar_cli_source)"
  mkdir -p "$HOME/.local/bin"
  if [[ ! -e "$target" && ! -L "$target" ]]; then
    ln -s "$src" "$target" && echo "Linked ~/.local/bin/hotbar"
    return 0
  fi
  if [[ -L "$target" ]]; then
    resolved="$(resolve_link "$target")"
    if [[ "$resolved" == "$src" ]]; then
      # Idempotent: already ours. Refresh a dangling link if needed.
      if [[ ! -e "$target" ]]; then ln -sf "$src" "$target"; fi
      echo "hotbar: ~/.local/bin/hotbar already points at this HOTBAR CLI"
      return 0
    fi
    echo "hotbar: $target is a symlink to '${resolved:-<unresolvable>}' — not this HOTBAR CLI ($src); leaving it alone" >&2
    return 1
  fi
  echo "hotbar: $target exists and is not owned by HOTBAR; leaving it alone" >&2
  return 1
}

cmd_uninstall() {
  local rc=0 target state_file state_dir
  target="$(hotbar_cli_link)"
  state_file="$(hotbar_state_file)"
  state_dir="$(dirname "$state_file")"
  if cli_owned_by_hotbar; then
    if rm -- "$target"; then
      echo "Removed $target"
    else
      echo "hotbar: could not remove $target" >&2; rc=1
    fi
  elif [[ -e "$target" || -L "$target" ]]; then
    echo "note: $target is not owned by HOTBAR; leaving it alone"
  else
    echo "note: no CLI link at $target"
  fi
  if [[ -f "$state_file" ]]; then
    if rm -- "$state_file"; then
      echo "Removed $state_file"
    else
      echo "hotbar: could not remove $state_file" >&2; rc=1
    fi
  else
    echo "note: no HOTBAR state file at $state_file"
  fi
  # Only the HOTBAR state file's own directory, and only when empty. Shared
  # Omarchy directories above it are never touched.
  if [[ -d "$state_dir" ]]; then rmdir -- "$state_dir" 2>/dev/null || true; fi
  if [[ -d "$HOME/.config/omarchy/plugins/$PLUGIN_ID" ]]; then
    if omarchy plugin remove "$PLUGIN_ID" --yes; then
      echo "Removed plugin $PLUGIN_ID"
    else
      echo "hotbar: 'omarchy plugin remove $PLUGIN_ID --yes' failed" >&2; rc=1
    fi
  else
    echo "note: plugin $PLUGIN_ID is not installed"
  fi
  return $rc
}

# Hyprland cursor warps live in the compositor, not in Hotbar. Hotbar only
# reads them for `doctor`/`warp status` and manages one clearly-marked
# override block in ~/.config/hypr/looknfeel.lua for `warp off|on`.
# It never touches Omarchy defaults under /usr/share/omarchy/.
hypr_looknfeel_file() { printf '%s' "$HOME/.config/hypr/looknfeel.lua"; }

warp_block_begin() { printf '%s' "-- BEGIN greyforge.hotbar warp"; }
warp_block_end() { printf '%s' "-- END greyforge.hotbar warp"; }

warp_block_body() {
  # warp_block_body <off|on> — print the managed hl.config block.
  if [[ "${1:-off}" == "on" ]]; then
    cat <<'EOF'
-- Managed by `hotbar warp on`. Restores Omarchy default cursor warping.
-- Edit via `hotbar warp on|off|status`. Do not hand-edit between markers.
hl.config({
  cursor = {
    no_warps = false,
    warp_on_change_workspace = 1,
    warp_on_toggle_special = 0,
  },
})
EOF
  else
    cat <<'EOF'
-- Managed by `hotbar warp off`. Disables Hyprland cursor warping that yanks
-- the pointer to window/workspace center on Hotbar focus.
-- Edit via `hotbar warp on|off|status`. Do not hand-edit between markers.
hl.config({
  cursor = {
    no_warps = true,
    warp_on_change_workspace = 0,
    warp_on_toggle_special = 0,
  },
})
EOF
  fi
}

# Parse `hyprctl getoption <key>` output. Prints the value or "".
hypr_option_value() {
  local key="$1" out="" line=""
  out="$(hyprctl getoption "$key" 2>/dev/null || true)"
  while IFS= read -r line; do
    case "$line" in
      "int: "*|"bool: "*|"str: "*|"float: "*)
        printf '%s' "${line#*: }"
        return 0
        ;;
    esac
  done <<<"$out"
  printf ''
}

# warp_read_state — prints `no_warps=<v> warp_workspace=<v> warp_special=<v>`
# and returns 0 disabled, 1 enabled, 2 unknown (hyprctl missing/parse fail).
warp_read_state() {
  command -v hyprctl >/dev/null 2>&1 || return 2
  local no_warps="" ws="" special=""
  no_warps="$(hypr_option_value "cursor:no_warps")"
  ws="$(hypr_option_value "cursor:warp_on_change_workspace")"
  special="$(hypr_option_value "cursor:warp_on_toggle_special")"
  [[ -n "$no_warps" && -n "$ws" ]] || return 2
  printf 'no_warps=%s warp_workspace=%s warp_special=%s\n' "$no_warps" "$ws" "${special:-?}"
  if [[ "$no_warps" == "true" && "$ws" == "0" ]]; then return 0; fi
  return 1
}

cmd_warp_status() {
  local state="" rc=0
  state="$(warp_read_state)" || rc=$?
  if (( rc == 2 )); then
    echo "unknown: hyprctl not found or cursor options unreadable"
    return 2
  fi
  echo "$state"
  if (( rc == 0 )); then
    echo "warps disabled"
  else
    echo "warps enabled (pointer jumps to center on Hotbar focus; run: hotbar warp off)"
  fi
  return $rc
}

cmd_warp_apply() {
  # cmd_warp_apply <off|on>
  local mode="${1:-off}" file="" tmp="" backup=""
  [[ "$mode" == "on" || "$mode" == "off" ]] || { echo "hotbar: warp expects off|on|status" >&2; return 1; }
  file="$(hypr_looknfeel_file)"
  mkdir -p "$(dirname "$file")"
  [[ -f "$file" ]] || printf '%s\n' "-- Change the default Omarchy look'n'feel." "" >"$file"
  backup="${file}.bak.$(date +%s)"
  cp -- "$file" "$backup" && echo "Backed up $file to $backup"
  tmp="$(mktemp)"
  awk -v begin="$(warp_block_begin)" -v end="$(warp_block_end)" '
    $0 == begin { inblock = 1; next }
    $0 == end { inblock = 0; next }
    !inblock { print }
  ' "$file" >"$tmp"
  {
    printf '%s\n' "$(warp_block_begin)"
    warp_block_body "$mode"
    printf '%s\n' "$(warp_block_end)"
  } >>"$tmp"
  cat -- "$tmp" >"$file"
  rm -f -- "$tmp"
  if (( $(grep -c "no_warps" "$file" 2>/dev/null || true) > 1 )); then
    echo "warn: $file sets no_warps more than once (a hand-edit outside the managed block?); the last block wins — remove the hand-edit and keep the managed one" >&2
  fi
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || echo "warn: hyprctl reload failed" >&2
    local errors=""
    errors="$(hyprctl configerrors 2>&1 || true)"
    if [[ -n "$errors" ]]; then
      echo "warn: hyprctl configerrors:" >&2
      printf '%s\n' "$errors" >&2
      return 1
    fi
    echo "Applied cursor warps=$mode and reloaded Hyprland config."
  else
    echo "Applied cursor warps=$mode to $file (hyprctl not found; reload on next login)."
  fi
}

cmd_doctor() {
  local ok=0 target src resolved state_file
  target="$(hotbar_cli_link)"
  src="$(hotbar_cli_source)"
  state_file="$(hotbar_state_file)"
  check() { if "$@" >/dev/null 2>&1; then echo "ok   $*"; else echo "MISSING $*"; ok=1; fi; }
  dir="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
  if [[ -f "$dir/manifest.json" ]]; then
    echo "ok   plugin files at $dir"
  else
    echo "MISSING plugin dir $dir"; ok=1
  fi
  if cli_owned_by_hotbar; then
    echo "ok   CLI link $target -> this HOTBAR CLI"
  elif [[ -e "$target" || -L "$target" ]]; then
    resolved="$(resolve_link "$target")"
    echo "CONFLICT $target points at '${resolved:-<unresolvable>}' (run 'hotbar install' after removing it, or leave it)"; ok=1
  else
    echo "MISSING CLI link $target (run: hotbar install)"; ok=1
  fi
  if [[ -f "$state_file" ]]; then
    echo "ok   HOTBAR state file at $state_file"
  else
    echo "note  no HOTBAR state file at $state_file (created on first settings write)"
  fi
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) echo "ok   ~/.local/bin is in PATH" ;;
    *) echo "warn  ~/.local/bin is not in PATH (hotbar will not resolve by name)" ;;
  esac
  check command -v jq
  check command -v findmnt
  check command -v xdg-open
  check command -v uwsm-app
  check command -v gtk-launch
  if omarchy-shell shell ping >/dev/null 2>&1; then
    echo "ok   omarchy-shell running"
    if omarchy-shell hotbar ping >/dev/null 2>&1; then
      echo "ok   HOTBAR IPC target answering"
      if state=$(ipc state 2>/dev/null); then
        echo "ok   widget live: region=$(jq -r .region <<<"$state") pins=$(jq -r '.pins|length' <<<"$state") windows=$(jq -r .windows <<<"$state")"
      else
        echo "MISSING widget not placed in the bar (run: hotbar install)"; ok=1
      fi
    else
      echo "MISSING HOTBAR IPC target not answering (run: hotbar install, or wait out a plugin reload)"; ok=1
    fi
  else
    echo "MISSING omarchy-shell not running"; ok=1
  fi
  if warp_state="$(warp_read_state 2>/dev/null)"; then
    echo "ok   cursor warps disabled ($warp_state)"
  else
    rc=$?
    if (( rc == 2 )); then
      echo "note  cannot read Hyprland cursor options (hyprctl unavailable)"
    else
      echo "warn  cursor warps enabled ($warp_state; pointer jumps to center on Hotbar focus; run: hotbar warp off)"
    fi
  fi
  pgrep -f "hotbar-places" >/dev/null && echo "note  a hotbar-places helper is running (it should exit within a second)"
  return $ok
}

cmd="${1:-}"
if (( $# > 0 )); then shift; fi

case "$cmd" in
  pin)
    [[ -n "${1:-}" ]] || { echo "hotbar pin <app>" >&2; exit 1; }
    need_shell; ipc pin "$1" ;;
  unpin)
    [[ -n "${1:-}" ]] || { echo "hotbar unpin <app>" >&2; exit 1; }
    need_shell; ipc unpin "$1" ;;
  pins)
    need_shell
    case "${1:-}" in
      set)
        shift
        (( $# )) || { echo "hotbar pins set <app>...   (use 'hotbar pins clear' to remove every pin)" >&2; exit 1; }
        joined=""
        for a in "$@"; do
          [[ "$a" == *"|"* ]] && { echo "hotbar: '|' is not allowed in a key" >&2; exit 1; }
          joined+="${joined:+|}$a"
        done
        ipc setPins "$joined" ;;
      clear) ipc setPins "" ;;
      "") ipc pins | tr '|' '\n' | sed '/^$/d' ;;
      *) echo "hotbar pins [set <app>...|clear]" >&2; exit 1 ;;
    esac ;;
  open)
    [[ -n "${1:-}" ]] || { echo "hotbar open places|running|settings|<app> [--screen <name>]" >&2; exit 1; }
    need_shell
    if [[ "${2:-}" == --screen && -n "${3:-}" ]]; then ipc openOn "$3" "$1"; else ipc open "$1"; fi ;;
  close)
    need_shell
    if [[ "${1:-}" == --screen && -n "${2:-}" ]]; then ipc closeOn "$2"; else ipc close; fi ;;
  activate)
    [[ -n "${1:-}" ]] || { echo "hotbar activate <app|n>" >&2; exit 1; }
    need_shell
    if [[ "$1" =~ ^[0-9]+$ ]]; then ipc activateIndex "$1"; else ipc activate "$1"; fi ;;
  new)
    [[ -n "${1:-}" ]] || { echo "hotbar new <app>" >&2; exit 1; }
    need_shell; ipc newWindow "$1" ;;
  identify)
    need_shell
    ipc identify | jq -r '.[] | [.appId, .class, "->", .key, "(" + .source + ")"] | @tsv' | column -t ;;
  state) need_shell; ipc state | jq . ;;
  set)
    [[ -n "${1:-}" && $# -ge 2 ]] || { echo "hotbar set <key> <value>" >&2; exit 1; }
    need_shell
    key="$1"; value="$2"
    # JSON when it parses as JSON, otherwise a plain string.
    if json=$(jq -cn --argjson v "$value" '$v' 2>/dev/null); then :; else json=$(jq -cn --arg v "$value" '$v'); fi
    ipc setSetting "$key" "$(printf '%s' "$json" | od -An -v -tx1 | tr -d ' \n')" ;;
  get)
    [[ -n "${1:-}" ]] || { echo "hotbar get <key>" >&2; exit 1; }
    need_shell; ipc getSetting "$1" ;;
  install)
    omarchy-shell shell setPluginEnabled "$PLUGIN_ID" true >/dev/null
    sleep 1
    omarchy bar move "$PLUGIN_ID" --section left --index 1
    install_cli_link
    echo "Hotbar placed after the Omarchy menu. Pin apps from the Running drawer or with: hotbar pin <app>" ;;
  uninstall) cmd_uninstall ;;
  import)
    [[ "${1:-}" == "omapanel" ]] || { echo "hotbar import omapanel [--apply]" >&2; exit 1; }
    cfg="$HOME/.config/omarchy/shell.json"
    [[ -f "$cfg" ]] || { echo "hotbar: no $cfg" >&2; exit 1; }
    # OmaPanel stores pins as a JSON string inside its layout entry:
    # [{label, match, launch, icon, desktopId}] — only desktopId / match are
    # carried over; launch commands are never imported.
    raw=$(jq -r '[.bar.layout[]? // [] | .[] | select(.id == "atagulalan.omapanel") | .pinnedApps // empty][0] // empty' "$cfg")
    [[ -n "$raw" ]] || { echo "hotbar: no OmaPanel entry with pinnedApps found in shell.json"; exit 0; }
    mapfile -t keys < <(jq -r 'if type == "string" then fromjson else . end | .[] | if (.desktopId // "") != "" then (.desktopId | sub("\\.desktop$"; "")) elif (.match // "") != "" then "class:" + (.match | gsub("\\\\"; "") | gsub("[\\^$]"; "") | ascii_downcase) else empty end' <<<"$raw")
    (( ${#keys[@]} )) || { echo "hotbar: OmaPanel entry has no importable pins"; exit 0; }
    echo "OmaPanel pins → Hotbar pins:"
    printf '  %s\n' "${keys[@]}"
    if [[ "${2:-}" == "--apply" ]]; then
      need_shell
      joined=""; for k in "${keys[@]}"; do joined+="${joined:+|}$k"; done
      ipc setPins "$joined"
      echo "Applied. OmaPanel itself was not touched; remove it with: omarchy plugin remove atagulalan.omapanel"
    else
      echo "Dry run. Re-run with --apply to write these pins."
    fi ;;
  doctor) cmd_doctor ;;
  warp)
    case "${1:-status}" in
      status) cmd_warp_status ;;
      off|on) cmd_warp_apply "$1" ;;
      *) echo "hotbar: warp expects off|on|status" >&2; exit 1 ;;
    esac ;;
  -h|--help|help|"") usage ;;
  *) echo "hotbar: unknown command '$cmd'" >&2; usage >&2; exit 1 ;;
esac

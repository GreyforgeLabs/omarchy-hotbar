   "title": "Under the hood",
   "duration": 6.72,
   "lines": [
    "$ hotbar doctor",
    "no daemon, no polling, no telemetry, no network",
    "focus change: < 1 ms of shell time",
    "launch = argv array; window action = Hyprland dispatcher",
    "41 model tests + live acceptance run against the shell",
    "$ omarchy plugin remove greyforge.hotbar   # leaves nothing behind"
   ]

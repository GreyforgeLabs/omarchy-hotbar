{
  "schemaVersion": 1,
  "id": "greyforge.hotbar",
  "name": "Hotbar",
  "version": "0.1.1",
  "author": "Greyforge Labs",
  "license": "MIT",
  "homepage": "https://github.com/GreyforgeLabs/omarchy-hotbar",
  "description": "Fixed app slots, filesystem Places, and one bounded drawer for everything else. Open fifty windows. Your bar stays put.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Hotbar.qml"
  },
  "barWidget": {
    "displayName": "Hotbar",
    "description": "Places, pinned apps and a Running drawer. One app = one cell, always in the same place.",
    "category": "Compositor",
    "aliases": ["hotbar", "apps", "places", "taskbar", "dock"],
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "pins": [],
      "matches": [],
      "favorites": [],
      "iconSize": 18,
      "spacing": 2,
      "iconStyle": "color",
      "runningIndicator": "underline",
      "separators": true,
      "previews": true,
      "previewDelay": 450,
      "animations": true,
      "wheelCycle": true,
      "middleClick": "new-window",
      "showPlaces": true,
      "showRunning": true,
      "responsive": true,
      "showDesktop": true,
      "showDownloads": true,
      "showDocuments": true,
      "showPictures": true,
      "showMusic": true,
      "showVideos": true,
      "showTrash": true,
      "showMounts": true
    },
    "schema": [
      { "key": "iconSize", "type": "integer", "label": "Icon size", "min": 12, "max": 24, "step": 1, "defaultValue": 18 },
      { "key": "spacing", "type": "integer", "label": "Cell spacing", "min": 0, "max": 12, "step": 1, "defaultValue": 2 },
      { "key": "iconStyle", "type": "enum", "label": "Icon style", "options": ["color", "mono"], "defaultValue": "color", "description": "mono tints app icons with the bar foreground so they read like the rest of the bar." },
      { "key": "runningIndicator", "type": "enum", "label": "Running indicator", "options": ["underline", "dot", "none"], "defaultValue": "underline" },
      { "key": "separators", "type": "boolean", "label": "Section separators", "defaultValue": true },
      { "key": "previews", "type": "boolean", "label": "Hover previews", "defaultValue": true },
      { "key": "previewDelay", "type": "integer", "label": "Preview delay (ms)", "min": 100, "max": 1500, "step": 50, "defaultValue": 450 },
      { "key": "animations", "type": "boolean", "label": "Animations", "defaultValue": true },
      { "key": "wheelCycle", "type": "boolean", "label": "Mouse wheel cycles windows", "defaultValue": true },
      { "key": "middleClick", "type": "enum", "label": "Middle click on an app", "options": ["new-window", "none"], "defaultValue": "new-window" },
      { "key": "showPlaces", "type": "boolean", "label": "Show Places", "defaultValue": true },
      { "key": "showRunning", "type": "boolean", "label": "Show Running drawer", "defaultValue": true },
      { "key": "responsive", "type": "boolean", "label": "Responsive overflow", "defaultValue": true, "description": "Collapse trailing pins into Running before colliding with other bar widgets." },
      { "key": "showDesktop", "type": "boolean", "label": "Places: Desktop", "defaultValue": true },
      { "key": "showDownloads", "type": "boolean", "label": "Places: Downloads", "defaultValue": true },
      { "key": "showDocuments", "type": "boolean", "label": "Places: Documents", "defaultValue": true },
      { "key": "showPictures", "type": "boolean", "label": "Places: Pictures", "defaultValue": true },
      { "key": "showMusic", "type": "boolean", "label": "Places: Music", "defaultValue": true },
      { "key": "showVideos", "type": "boolean", "label": "Places: Videos", "defaultValue": true },
      { "key": "showTrash", "type": "boolean", "label": "Places: Trash", "defaultValue": true },
      { "key": "showMounts", "type": "boolean", "label": "Places: mounted drives", "defaultValue": true }
    ]
  }
}
